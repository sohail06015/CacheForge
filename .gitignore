# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# strata runtime data - the AOF log the engine writes.
# Local state, not source. Committing it would push your test keys
# to GitHub and cause a conflict on every pull.
data/
*.aof
*.history

# Test scratch directories
.test-data/

# Environment / secrets
# strata_PASSWORD lives here if you set one - never commit it.
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini
